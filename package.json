{
  "name": "exercicio-m24",
  "version": "1.0.0",
  "main": "index.js",
  "description": "Exercicio M24",
  "author": "renan yassumoto",
  "license": "ISC",
  "scripts": {
    "tests": "mocha --require ./test/setupFlow.js ./test/**/*.test.js",
    "test:gql": "mocha --require ./test/setupFlow.js ./test/graphql/**/*.test.js",
    "test:rest": "mocha --require ./test/setupFlow.js ./test/api/**/*.test.js --timeout 15000",
    "test:rest:report": "mocha --require ./test/setupFlow.js ./test/api/**/*.test.js --timeout 15000 --reporter mochawesome --reporter-option reportDir=reports/rest --reporter-option reportFilename=index --reporter-option overwrite=true --reporter-option quiet=true --reporter-option html=true --reporter-option json=false --reporter-option inlineAssets=true",
    "test:contractProvider": "mocha --require ./test/setupFlow.js ./test/contract/loginProvider.test.js",
    "test:contractConsumer": "mocha --require ./test/setupFlow.js ./test/contract/loginConsumer.test.js",
    "test:contract:category": "mocha --require ./test/setupFlow.js ./test/contract/categoryContract.test.js",
    "test:contract:product": "mocha --require ./test/setupFlow.js ./test/contract/productContract.test.js",

    "test": "mocha --require ./test/setupFlow.js ./test/**/*.test.js --timeout 15000 --reporter mochawesome --reporter-option reportDir=reports/mochawesome,reportFilename=results,quiet=true,html=false,json=true",
    "report:merge": "mochawesome-merge reports/mochawesome/*.json > reports/mochawesome/merged.json",
    "report:html": "marge reports/mochawesome/merged.json --reportDir reports/mochawesome --inline true --charts true",
    "test:report": "npm run test && npm run report:merge && npm run report:html"
  },
  "dependencies": {
    "mocha": "^11.7.2",
    "pactum": "^3.8.0",
    "pactum-flow-plugin": "^0.1.4",
    "pactum-matchers": "^1.1.7"
  },
  "devDependencies": {
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.3.0"
  }
}
